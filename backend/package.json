{
  "name": "reachinbox-scheduler-backend",
  "version": "1.0.0",
  "description": "Email job scheduler backend using BullMQ + Redis + Postgres",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "tsx watch src/queue/worker.ts",
    "worker:build": "node dist/queue/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed:senders": "tsx src/scripts/seedSenders.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^9.13.0",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "papaparse": "^5.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^6.4.15",
    "@types/papaparse": "^5.3.14",
    "prisma": "^5.19.0",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "esbuild@0.28.2": true
  }
}
